CREATE TABLE pessoa ( 
id int NOT NULL AUTO_INCREMENT,  
nome varchar (30) NOT NULL, 
nascimento date, 
sexo enum ('M','F'),
peso decimal (5,2),
altura decimal (3,2) ,
nacionalidade varchar (30) default 'Brasil',
PRIMARY KEY (id)
)DEFAULT CHARSET = utf8;


create table cidade (
id_cidade int PRIMARY KEY, 
nome varchar (30) ,
coduf int ,
foreign key (coduf) references uf (coduf) 
);
		
create table cep (
id_cep int PRIMARY KEY ,
numcep char (8),
id_cidade int , 
foreign key (id_cidade) references cidade(id_cidade)
);
	

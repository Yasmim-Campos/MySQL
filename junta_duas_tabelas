create database crud1;
use crud1; 

create table uf
	(coduf int primary key,estado char (2)); 

create table cliente 
	(codigo int primary key, nome varchar (30),salario decimal(12,2),
	coduf int, foreign key (coduf) references uf(coduf));
    
